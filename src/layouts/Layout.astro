---
import Styles from "@/components/core/Styles.astro";
import Head from "@/components/core/Head.astro";
import { defaultLocale } from "@/i18n/translator";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof Head>;
const lang = Astro.currentLocale ?? defaultLocale;
---

<!doctype html>
<html lang={lang}>
    <head>
        <Head {...Astro.props} />
        <Styles />
    </head>
    <body>
        <slot />
    </body>
</html>
