---
import Styles from "@/components/head/Styles.astro";
import Head from "@/components/head/Head.astro";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof Head>;
const { locale } = Astro.locals;
---

<!doctype html>
<html lang={locale}>
    <head>
        <Head {...Astro.props} />
        <Styles />
    </head>
    <body class="bg-light">
        <slot />
    </body>
</html>
