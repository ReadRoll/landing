---
import Layout from "@/layouts/Layout.astro";
import LegalHeader from "@/components/legal/LegalHeader.astro";
import type { RouteKey } from "@/lib/i18n/routes";
import ProseLink from "@/components/markdown/ProseLink.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

type Props = {
    metaTitle: string;
    route: RouteKey;
    title: string;
    updatedAt: Date;
    content: AstroComponentFactory;
};

const { metaTitle, route, title, updatedAt, content: Content } = Astro.props;
const mdxComponents = { a: ProseLink };
---

<Layout title={metaTitle} route={route}>
    <main class="min-h-dvh flex flex-col px-4 py-10">
        <div class="flex flex-col gap-8 max-w-4xl mx-auto md:mt-30">
            <LegalHeader title={title} updatedAt={updatedAt} />
            <article class="legal-prose">
                <Content components={mdxComponents} />
            </article>
        </div>
    </main>
</Layout>
