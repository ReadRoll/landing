---
import type { HTMLAttributes } from "astro/types";

// Props
type LinkProps = { href: string } & HTMLAttributes<"a">;
type ButtonProps = { href?: never } & HTMLAttributes<"button">;
type VariantProps = "primary" | "light" | "light-outline";
type Props = (LinkProps | ButtonProps) & {
    variant?: VariantProps;
};
const { variant = "light", ...props } = Astro.props;

// HTML Tag
const Tag = props.href !== undefined ? "a" : "button";
const attributes = props as Record<string, unknown>;

// Variants
const classList = "text-sm/[1.1875rem] cursor-pointer flex justify-center items-center gap-2 border rounded-md px-4 py-3 md:px-6 transition active:scale-[0.98]";
const variantClassMapper = {
    primary: "bg-primary border-primary text-light hover:bg-primary-hover hover:border-primary-hover",
    light: "bg-light border-gray-100 hover:border-gray-200 hover:bg-gray-100/40",
    "light-outline": "bg-transparent border-light/30 text-light hover:bg-light/10",
} satisfies Record<VariantProps, string>;
const classes = [classList, variantClassMapper[variant]];
---

<Tag class:list={classes} {...attributes}>
    <span class="size-4 shrink-0 *:size-full empty:hidden" aria-hidden="true">
        <slot name="icon" />
    </span>
    <slot />
</Tag>
