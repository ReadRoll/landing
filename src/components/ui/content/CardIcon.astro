---
type Props = {
    title: string;
    description: string;
};

const { title, description } = Astro.props;
---

<div class="flex flex-col gap-6 h-full rounded-2xl border border-gray-100 bg-light p-6 sm:p-8">
    <span class="size-16 text-primary *:size-full" aria-hidden="true">
        <slot name="icon" />
    </span>

    <div class="flex flex-col gap-2">
        <h3 class="text-md">{title}</h3>
        <p class="text-sm">{description}</p>
    </div>
</div>
