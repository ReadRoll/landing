---
import type { HTMLAttributes } from "astro/types";

type Props = { href: string; variant?: "dark" | "light" } & HTMLAttributes<"a">;

const { variant = "dark", class: className, ...props } = Astro.props;

const variantClassMapper = {
    dark: "hover:text-primary focus-visible:text-primary",
    light: "text-light/70 hover:text-light focus-visible:text-light",
};
const classes = ["transition", variantClassMapper[variant], className];
---

<a class:list={classes} {...props}>
    <slot />
</a>
