---
import { sectionIds } from "@/lib/navigation/landingSection";
import FAQItem from "@/components/ui/content/FAQItem.astro";
import { interpolate } from "@/lib/i18n/interpolate";
import { contactEmail } from "@/lib/contact";

const { t } = Astro.locals;
const faq = t.landing.faq;
const faqList = Object.values(faq.items);

// Links
const emailLink = `<a href="mailto:${contactEmail}">${contactEmail}</a>`;
const formatResponse = (response: string) => interpolate(response, { email: emailLink });
---

<section id={sectionIds.faq} class="flex flex-col md:flex-row justify-between gap-6 py-6 xl:py-20">
    <h2 class="text-2xl max-w-[22rem]">{faq.title}</h2>

    <div class="flex flex-col w-full lg:max-w-[35rem] divide-y divide-gray-100 *:py-5">
        {faqList.map(({ question, response }) => (
            <FAQItem question={question} name="faq">
                <Fragment set:html={formatResponse(response)} />
            </FAQItem>
        ))}
    </div>
</section>
