---
import Layout from "@/layouts/Layout.astro";

const { t, paths } = Astro.locals;
const metaTitle = t.landing.page_title;
---

<Layout title={metaTitle} route="home" withSiteName={false}>
    <h1 class="text-xl text-primary">{t.landing.hero.title}</h1>

    <a href={paths.legal}>{t.legal.legal_mention_title}</a>
    <a href={paths.privacy}>Privacy</a>
    <a href={paths.terms}>TOS</a>
</Layout>
