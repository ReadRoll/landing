---
import Button from "@/components/ui/action/Button.astro";
import QuestionIcon from "@/assets/icons/question.svg";
import ArrowUpRightIcon from "@/assets/icons/arrow-up-right.svg";
import { sectionIds } from "@/lib/navigation/landingSection";

const { t } = Astro.locals;
const heroContent = t.landing.hero;

const featuresHref = `#${sectionIds.features}`;
const faqHref = `#${sectionIds.faq}`;
---

<section class="decorative-background min-h-[70dvh] flex flex-col justify-center">
    <div class="max-w-[40rem]">
        <h1 class="flex flex-col text-2xl md:text-[3rem] font-normal [&_strong]:text-primary [&_strong]:font-normal pb-6">
            <span set:html={heroContent.title} />
            <span>{heroContent.subtitle}</span>
        </h1>

        <p class="text-sm md:text-base pb-8">{heroContent.description}</p>

        <div class="flex flex-col xs:flex-row gap-3">
            <Button href={faqHref} variant="light">
                <QuestionIcon slot="icon" />
                {heroContent.questions}
            </Button>

            <Button href={featuresHref} variant="primary">
                <ArrowUpRightIcon slot="icon" />
                {heroContent.discover}
            </Button>
        </div>
    </div>
</section>
