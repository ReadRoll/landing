---
import Layout from "@/layouts/Layout.astro";
import Navigation from "@/components/layout/Navigation.astro";
import Hero from "@/components/landing/Hero.astro";
import Features from "@/components/landing/Features.astro";
import Footer from "@/components/layout/Footer.astro";
import ChangeLogs from "@/components/landing/Changelogs.astro";
import FAQ from "@/components/landing/FAQ.astro";

const { t } = Astro.locals;
const routeName = "home";
---

<Layout metaTitle={t.landing.page_title} metaDescription={t.landing.meta_description} route={routeName} withSiteName={false}>
    <div class="page-container pt-4">
        <Navigation route={routeName} />
        <main>
            <Hero />
            <div class="flex flex-col gap-20 lg:gap-40 pt-20 *:scroll-mt-10 lg:*:scroll-mt-20">
                <Features />
                <ChangeLogs />
                <FAQ />
            </div>
        </main>
    </div>
    <Footer route={routeName} />
</Layout>
