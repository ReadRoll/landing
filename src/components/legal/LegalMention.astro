---
import * as en from "@/content/legal/en/LegalMention.mdx";
import * as fr from "@/content/legal/fr/LegalMention.mdx";
import type { Locale } from "@/i18n/locales";
import LegalLayout from "@/layouts/LegalLayout.astro";
import ProseLink from "@/components/markdown/ProseLink.astro";

const contents: Record<Locale, typeof en> = { en, fr };

const { locale, t } = Astro.locals;
const { Content, frontmatter } = contents[locale];
const updatedAt = new Date(frontmatter.updatedAt);
---

<LegalLayout metaTitle={t.legal.legal_mention_title} route="legal" title={frontmatter.title} updatedAt={updatedAt} content={Content} />
