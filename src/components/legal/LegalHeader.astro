---
import BackIcon from "@/assets/icons/back.svg";

type Props = {
    title: string;
    updatedAt: Date;
};

const { title, updatedAt } = Astro.props;
const { locale, t, paths } = Astro.locals;
const dateFormatter = new Intl.DateTimeFormat(locale, { dateStyle: "long" });
const updatedAtLabel = `${t.legal.updated_on} ${dateFormatter.format(updatedAt)}`;
---

<div class="flex flex-col gap-6">
    <a href={paths.home} class="text-sm text-gray-300 flex items-center gap-2 self-start">
        <BackIcon class="size-3" aria-hidden="true" />
        <span class="underline">{t.legal.back_home}</span>
    </a>

    <div>
        <h1 class="text-xl font-bold">{title}</h1>
        <small class="text-xs text-gray-300 italic">{updatedAtLabel}</small>
    </div>
</div>
