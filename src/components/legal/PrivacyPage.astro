---
import * as en from "@/content/legal/en/Privacy.mdx";
import * as fr from "@/content/legal/fr/Privacy.mdx";
import type { Locale } from "@/lib/i18n/locales";
import LegalLayout from "@/layouts/LegalLayout.astro";

const contents: Record<Locale, typeof en> = { en, fr };

const { locale, t } = Astro.locals;
const { Content, frontmatter } = contents[locale];
const updatedAt = new Date(frontmatter.updatedAt);
---

<LegalLayout metaTitle={t.legal.privacy_title} metaDescription={t.legal.privacy_description} route="privacy" title={frontmatter.title} updatedAt={updatedAt} content={Content} />
