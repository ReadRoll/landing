---
import { getChangelogs } from "@/lib/changelogs/changelogFetcher";
import ChangelogCard from "@/components/changelog/ChangelogCard.astro";
import BackHomeLink from "@/components/layout/BackHomeLink.astro";

const { t, locale } = Astro.locals;

const changelogsItem = await getChangelogs(locale);
---

<section class="decorative-background">
    <div class="flex flex-col gap-3">
        <BackHomeLink />
        <h1 class="text-2xl md:text-[2.5rem] pb-8 [&_strong]:text-primary [&_strong]:font-normal">
            <span set:html={t.changelog.page_title} />
        </h1>
    </div>
    <ul class="grid lg:grid-cols-3 gap-10">
        {changelogsItem.map((entry) => (
            <li>
                <ChangelogCard entry={entry} />
            </li>
        ))}
    </ul>
</section>
