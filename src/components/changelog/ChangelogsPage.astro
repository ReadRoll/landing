---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/layout/Footer.astro";
import ChangelogList from "./ChangelogList.astro";

const { t } = Astro.locals;
const routeName = "changelogs";
---

<Layout metaTitle={t.changelog.page_title} metaDescription={t.changelog.meta_description} route={routeName}>
    <div class="page-container pt-20">
        <main class="min-h-[70dvh]">
            <ChangelogList />
        </main>
    </div>
    <Footer route={routeName} />
</Layout>
