---
import { getAlternateLinks } from "@/lib/i18n/meta";
import { routes, type RouteKey } from "@/lib/i18n/routes";

type Props = {
    metaTitle: string;
    metaDescription?: string;
    withSiteName?: boolean;
    type?: "website" | "article";
    route?: RouteKey;
    noindex?: boolean;
};

const { locale } = Astro.locals;
const { metaTitle, metaDescription, withSiteName = true, type = "website", route, noindex = false } = Astro.props;

// Page
const siteName = "ReadRoll";
const documentTitle = withSiteName ? `${metaTitle} | ${siteName}` : metaTitle;

// Favicons
const favicon = {
    apple: "/favicons/apple-touch-icon.png",
    iconpng: "/favicons/favicon-32x32.png",
    iconsvg: "/favicons/favicon.svg",
    iconico: "/favicons/favicon.ico",
};

// Language alternates (none when the page passes no route, e.g. 404)
const alternateLinks = route ? getAlternateLinks(routes[route], Astro.site) : [];

// Open Graph
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(`/og/${locale}.png`, Astro.site).href;
const og = {
    metaTitle,
    metaDescription,
    type,
    url: pageUrl,
    image: imageUrl,
    siteName,
};
---

{/* Base */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

{/* Page */}
<title>{documentTitle}</title>
{metaDescription && <meta name="description" content={metaDescription} />}
{noindex && <meta name="robots" content="noindex" />}

{/* Favicons */}
<link rel="apple-touch-icon" sizes="180x180" href={favicon.apple} />
<link rel="icon" type="image/png" sizes="32x32" href={favicon.iconpng} />
<link rel="icon" type="image/svg+xml" href={favicon.iconsvg} />
<link rel="shortcut icon" href={favicon.iconico} />

{/* Language alternates */}
{alternateLinks.map((link) => (
    <link rel="alternate" hreflang={link.hreflang} href={link.href} />
))}

{/* Open Graph */}
<meta property="og:title" content={og.metaTitle} />
{og.metaDescription && <meta property="og:description" content={og.metaDescription} />}
<meta property="og:type" content={og.type} />
<meta property="og:url" content={og.url} />
<meta property="og:image" content={og.image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={og.siteName} />
