---
import type { Changelog } from "@/lib/changelogs/changelogFetcher";
import { render } from "astro:content";
import Badge from "@/components/ui/content/Badge.astro";
import type { ComponentProps } from "astro/types";

const { locale, t } = Astro.locals;

// Props
type Props = { entry: Changelog };
const { entry } = Astro.props;

// Content
const { Content } = await render(entry);
const { type, title, date } = entry.data;
const formattedDate = date.toLocaleDateString(locale, { day: "2-digit", month: "short", year: "numeric" });

// Badge tag mapping
const badgeVariantMapper = {
    feature: "primary",
    security: "dark",
    improvement: "light",
    information: "light-outline",
} satisfies Record<Changelog["data"]["type"], ComponentProps<typeof Badge>["variant"]>;
---

<article class="group flex flex-col gap-6 h-full">
    <div class="flex items-center" aria-hidden="true">
        <span class="grid size-4 shrink-0 place-items-center rounded-full bg-gray-100/75">
            <span class="size-1 rounded-full bg-gray-100"></span>
        </span>
        <span class="relative h-px flex-1 bg-gray-100/30">
            <span class="absolute inset-0 origin-left scale-x-0 bg-gray-100 transition-transform duration-400 group-hover:scale-x-100 motion-reduce:transition-none"></span>
        </span>
    </div>

    <div class="flex flex-col gap-6 h-full">
        <Badge variant={badgeVariantMapper[type]}>{t.changelog.types[type]}</Badge>

        <div class="flex flex-col gap-2">
            <h3 class="text-light text-md">{title}</h3>
            <div class="text-light text-sm">
                <Content />
            </div>
        </div>

        <time datetime={date.toISOString()} class="text-gray-100 text-sm uppercase mt-auto">
            {formattedDate}
        </time>
    </div>
</article>
