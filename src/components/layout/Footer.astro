---
import type { RouteKey } from "@/lib/i18n/routes";
import FooterLinkGroup from "@/components/layout/FooterLinkGroup.astro";
import LangMenu from "@/components/layout/LangMenu.astro";
import { getNavigationLinks } from "@/lib/navigation/navigationLinks";
import SignInButton from "@/components/layout/SignInButton.astro";

const { t, paths } = Astro.locals;
const footer = t.site.footer;

// Props
type Props = { route?: RouteKey };
const { route } = Astro.props;

// Links
const legalLinks = [
    { label: t.legal.legal_mention_title, href: paths.legal, target: "_blank" },
    { label: t.legal.privacy_title, href: paths.privacy, target: "_blank" },
    { label: t.legal.terms_title, href: paths.terms, target: "_blank" },
];
const navigationLinks = getNavigationLinks(Astro.locals);
---

<footer class="w-full bg-secondary py-16 px-4 md:px-6 mt-20 lg:mt-30">
    <div class="page-container grid grid-cols-2 gap-10 lg:grid-cols-4">
        <div class="col-span-2 flex flex-col lg:col-span-1">
            <h2 class="text-2xl text-light">ReadRoll.</h2>
            <small class="text-light text-sm">{footer.tagline}</small>
        </div>
        <FooterLinkGroup title={footer.legal} links={legalLinks} />
        <FooterLinkGroup title={footer.sitemap} links={navigationLinks} />
        <div class="col-span-2 flex md:flex-col gap-3 lg:col-span-1 lg:justify-self-end *:flex-1">
            <SignInButton variant="light" />
            <LangMenu id="footer-language-menu" variant="light-outline" route={route} />
        </div>
    </div>
</footer>
