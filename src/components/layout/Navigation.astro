---
import NavigationLink from "@/components/ui/navigation/NavigationLink.astro";
import LangMenu from "@/components/layout/LangMenu.astro";
import type { RouteKey } from "@/lib/i18n/routes";
import NavigationMobileMenu from "@/components/layout/NavigationMobileMenu.astro";
import SignInButton from "@/components/layout/SignInButton.astro";
import { getNavigationLinks } from "@/lib/navigation/navigationLinks";

const { t, paths } = Astro.locals;

// Props
type Props = { route?: RouteKey };
const { route } = Astro.props;

// Links
const navigationLinks = getNavigationLinks(Astro.locals);
---

<header>
    <nav class="w-full flex items-center justify-between border-b border-gray-100 pt-3 pb-4 [anchor-name:--navigation]">
        <a href={paths.home} class="font-title text-lg">
            ReadRoll.
        </a>

        <ul class="hidden items-center gap-8 text-sm md:flex">
            {navigationLinks.map(({ label, href }) => (
                <li>
                    <NavigationLink href={href}>{label}</NavigationLink>
                </li>
            ))}
        </ul>

        <div class="hidden gap-3 md:flex">
            <LangMenu id="language-menu" route={route} />
            <SignInButton />
        </div>

        <NavigationMobileMenu links={navigationLinks} route={route} />
    </nav>
</header>
