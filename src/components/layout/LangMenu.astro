---
import LangIcon from "@/assets/icons/lang.svg";
import { routes, type RouteKey } from "@/lib/i18n/routes";
import { locales } from "@/lib/i18n/locales";
import type { ComponentProps } from "astro/types";
import Dropdown from "@/components/ui/overlay/Dropdown.astro";
import DropdownItem from "@/components/ui/overlay/DropdownItem.astro";

const { locale, t } = Astro.locals;

// Props
type Props = {
    id: string;
    route?: RouteKey;
    variant?: ComponentProps<typeof Dropdown>["variant"];
};
const { id, route = "home", variant } = Astro.props;

// Langs
const options = locales.map((optionLocale) => ({
    locale: optionLocale,
    name: t.lang[optionLocale],
    href: routes[route][optionLocale],
    current: optionLocale === locale ? ("page" as const) : undefined,
}));
---

<Dropdown id={id} label={t.site.navigation.lang} variant={variant}>
    <LangIcon slot="icon" />
    {options.map((option) => (
        <DropdownItem href={option.href} hreflang={option.locale} lang={option.locale} aria-current={option.current}>
            {option.name}
        </DropdownItem>
    ))}
</Dropdown>
