---
import NavigationLink from "@/components/ui/navigation/NavigationLink.astro";
import LangMenu from "@/components/layout/LangMenu.astro";
import MenuIcon from "@/assets/icons/menu.svg";
import CloseIcon from "@/assets/icons/close.svg";
import type { RouteKey } from "@/lib/i18n/routes";
import SignInButton from "@/components/layout/SignInButton.astro";

const { t } = Astro.locals;

// Props
type Props = {
    links: { label: string; href: string }[];
    route?: RouteKey;
};
const { links, route } = Astro.props;

// Style
const toggleIconClasses = "size-6 transition-[opacity,rotate] duration-200";
const menuIconClasses = [toggleIconClasses, "menu-open:opacity-0 menu-open:rotate-90"];
const closeIconClasses = [toggleIconClasses, "opacity-0 -rotate-90 menu-open:opacity-100 menu-open:rotate-0"];
---

<button type="button" class="grid size-10 cursor-pointer place-items-center *:col-start-1 *:row-start-1 md:hidden" popovertarget="mobile-menu" aria-label={t.site.navigation.menu}>
    <MenuIcon class:list={menuIconClasses} aria-hidden="true" />
    <CloseIcon class:list={closeIconClasses} aria-hidden="true" />
</button>

<div id="mobile-menu" popover class="popover-transition inset-x-0 top-[anchor(bottom)] [position-anchor:--navigation] flex-col gap-6 border-b border-gray-100 bg-light p-6 max-md:open:flex md:hidden">
    <ul class="flex flex-col gap-4">
        {links.map(({ label, href }) => (
            <li>
                <NavigationLink href={href}>{label}</NavigationLink>
            </li>
        ))}
    </ul>

    <div class="flex flex-col gap-3 *:flex-1 sm:flex-row sm:flex-wrap">
        <LangMenu id="language-menu-mobile" route={route} />
        <SignInButton />
    </div>
</div>

<script>
    const closeMenu = (menu: HTMLElement) => {
        menu.hidePopover();
    };

    const lockScroll = (menu: HTMLElement) => {
        const isOpen = menu.matches(":popover-open");
        document.documentElement.classList.toggle("overflow-hidden", isOpen);
    };

    const initEvents = () => {
        const menu = document.getElementById("mobile-menu");
        if (!menu) return;

        const menuLinks = menu.querySelectorAll<HTMLAnchorElement>("a");
        menuLinks.forEach((link) =>
            link.addEventListener("click", () => {
                closeMenu(menu);
            }),
        );
        menu.addEventListener("toggle", () => {
            lockScroll(menu);
        });
    };

    initEvents();
</script>
